<resources>
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="browseTitleTextStyle">@style/BrowseTitleText</item>
    </style>

    <style name="BrowseTitleText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="SetupTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <style name="SetupSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">#BDBDBD</item>
        <item name="android:textSize">@dimen/section_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SetupActionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/action_height</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/button_focus_bg</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text_color</item>
        <item name="android:textSize">@dimen/section_text</item>
        <item name="android:drawableTint">@color/button_text_color</item>
        <item name="drawableTint">@color/button_text_color</item>
    </style>

    <style name="AppToolbarButton" parent="SetupActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:minWidth">@dimen/toolbar_button_min_width</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">@dimen/subtitle_text</item>
    </style>

    <style name="CastOverflowButton" parent="SetupActionButton">
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:background">@drawable/overflow_item_bg</item>
    </style>

    <style name="AppToolbarIconButton">
        <item name="android:layout_width">@dimen/toolbar_height</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:background">@drawable/button_focus_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/button_text_color</item>
    </style>
</resources>
