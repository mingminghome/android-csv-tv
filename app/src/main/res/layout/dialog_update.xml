<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    card_view:cardBackgroundColor="#1A1A1A"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/update_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update available"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_dialog_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="v1.0.5"
            android:textColor="#BDBDBD"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Release notes"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/update_notes_scroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#121212"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="12dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/update_dialog_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/update_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/update_progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Downloading…"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/update_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:indeterminateTint="#BDBDBD"
                android:progressBackgroundTint="#334455"
                android:progressTint="#BDBDBD" />

            <TextView
                android:id="@+id/update_progress_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:text="0%"
                android:textColor="#BDBDBD"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/button_focus_bg"
                android:focusable="true"
                android:minWidth="120dp"
                android:paddingHorizontal="20dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color" />

            <Button
                android:id="@+id/update_btn_action"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/button_focus_bg"
                android:focusable="true"
                android:minWidth="140dp"
                android:paddingHorizontal="20dp"
                android:text="Download"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
