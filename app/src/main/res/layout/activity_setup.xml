<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow (phone portrait): single column, actions pinned to the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <include
        android:id="@+id/app_toolbar"
        layout="@layout/include_app_toolbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="@dimen/page_gap"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SetupSectionTitle"
                android:layout_marginTop="0dp"
                android:text="CSV Source" />

            <EditText
                android:id="@+id/sheet_link_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/edit_text_bg"
                android:hint="CSV URL, Google Sheet, or shortlink"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@android:color/white"
                android:textColorHint="#66FFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/apply_button"
                style="@style/SetupActionButton"
                android:gravity="center"
                android:text="Apply" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Full URLs, published Google Sheet IDs, or shortlink IDs."
                android:textColor="#A0FFFFFF"
                android:textSize="13sp" />

            <TextView
                style="@style/SetupSectionTitle"
                android:text="Input" />

            <Button
                android:id="@+id/paste_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_paste"
                android:text="Paste clipboard" />

            <Button
                android:id="@+id/select_csv_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_folder"
                android:text="Select CSV file" />

            <Button
                android:id="@+id/history_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_history"
                android:text="Recent sources" />

            <TextView
                style="@style/SetupSectionTitle"
                android:text="Settings" />

            <Button
                android:id="@+id/auto_rotate_toggle"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_screen_rotation"
                android:text="@string/setup_auto_rotate_on"
                android:visibility="gone" />

            <Button
                android:id="@+id/source_details_toggle"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_settings_icon"
                android:text="Source details: OFF" />

            <TextView
                style="@style/SetupSectionTitle"
                android:text="@string/setup_section_cast" />

            <Button
                android:id="@+id/confirm_connection_toggle"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_receive"
                android:text="@string/setup_confirm_off" />

            <Button
                android:id="@+id/encryption_toggle"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_settings_icon"
                android:text="@string/setup_encryption_off" />

            <TextView
                style="@style/SetupSectionTitle"
                android:text="@string/setup_section_web" />

            <Button
                android:id="@+id/default_browser_toggle"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_image_icon"
                android:text="Search: DuckDuckGo" />

            <Button
                android:id="@+id/adblock_lists_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_check_circle"
                android:text="Adblock" />

            <TextView
                style="@style/SetupSectionTitle"
                android:text="Utilities" />

            <Button
                android:id="@+id/purge_freq_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_reset"
                android:text="Reset watch history" />

            <Button
                android:id="@+id/reset_all_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_reset"
                android:text="Reset all to default" />

            <TextView
                style="@style/SetupSectionTitle"
                android:text="About" />

            <Button
                android:id="@+id/about_button"
                style="@style/SetupActionButton"
                android:drawableStart="@drawable/ic_restore"
                android:text="About" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/setup_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/skip_setup_button"
            style="@style/SetupActionButton"
            android:layout_marginBottom="0dp"
            android:contentDescription="@string/setup_skip_hint"
            android:drawableStart="@drawable/ic_desktop"
            android:text="@string/setup_skip"
            android:tooltipText="@string/setup_skip_hint" />

        <TextView
            android:id="@+id/skip_setup_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_skip_hint"
            android:textColor="#A0FFFFFF"
            android:textSize="@dimen/subtitle_text" />
    </LinearLayout>

</LinearLayout>
