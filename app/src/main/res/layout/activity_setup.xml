<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Settings"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Two column layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Left: CSV Source + Input Options -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:orientation="vertical"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="start"
                    android:text="CSV Source"
                    android:textColor="#BDBDBD"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/sheet_link_input"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/edit_text_bg"
                        android:hint="Enter CSV URL / Google sheet, Bitly, TinyURL ID"
                        android:inputType="textUri"
                        android:paddingHorizontal="16dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="#66FFFFFF"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/apply_button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/button_focus_bg"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textColor="@color/button_text_color" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Supports full URLs (incl. shortlinks), published Google Sheet IDs, or shortlink IDs."
                    android:textColor="#A0FFFFFF"
                    android:textSize="13sp" />

                <!-- Input Options -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="start"
                    android:text="Input Options"
                    android:textColor="#BDBDBD"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/paste_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_paste"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Paste Clipboard"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

                <Button
                    android:id="@+id/select_csv_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Select CSV File"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

                <Button
                    android:id="@+id/history_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_history"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Recent Sources"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

            </LinearLayout>

            <!-- Right: Settings + About -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:orientation="vertical"
                android:paddingStart="20dp">

                <!-- Settings -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="start"
                    android:text="Settings"
                    android:textColor="#BDBDBD"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/source_details_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_settings_icon"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Show Source Details: OFF"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

                <Button
                    android:id="@+id/default_browser_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_image_icon"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Default Search: DuckDuckGo"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="start"
                    android:text="Utilities"
                    android:textColor="#BDBDBD"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/purge_freq_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_reset"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Reset Watch History"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

                <Button
                    android:id="@+id/reset_all_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_reset"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Reset All to Default"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="start"
                    android:text="About"
                    android:textColor="#BDBDBD"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/about_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_focus_bg"
                    android:drawableStart="@drawable/ic_restore"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="About"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom action bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="32dp"
            android:background="#22FFFFFF" />

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_focus_bg"
            android:drawableStart="@drawable/ic_close"
            android:drawablePadding="12dp"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/button_text_color" />

    </LinearLayout>
</ScrollView>